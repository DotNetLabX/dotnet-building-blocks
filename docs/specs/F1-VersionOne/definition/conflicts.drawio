<mxfile host="app.diagrams.net">
  <diagram name="Conflicts" id="conflicts">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;What a &amp;quot;conflict&amp;quot; is&lt;/b&gt;&lt;br&gt;The same class exists in two copies of the blocks with different shapes. Code written against one copy does not compile, or behaves differently, on the other. For each of the 20 we pick one shape for the master. The default is the reference's shape." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="70" as="geometry"/></mxCell>
        <mxCell id="hk" value="&lt;b&gt;Keep the reference's shape (16)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="540" height="36" as="geometry"/></mxCell>
        <mxCell id="hc" value="&lt;b&gt;Change it in the first release (4)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="540" height="36" as="geometry"/></mxCell>
        <mxCell id="k1" value="&lt;b&gt;1. HTTP error base class&lt;/b&gt; - keeps the status as a named code and the constructors that wrap an inner error" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="156" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k2" value="&lt;b&gt;2. HTTP error subclasses&lt;/b&gt; - the reference's constructors; 403, 409 and 502 are added as new classes" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="202" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k3" value="&lt;b&gt;3. Domain error&lt;/b&gt; - message plus an optional inner error" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="248" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k4" value="&lt;b&gt;4. Domain event marker&lt;/b&gt; - works with both MediatR and FastEndpoints" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="294" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k5" value="&lt;b&gt;5. Event publisher contract&lt;/b&gt; - one event per call" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k6" value="&lt;b&gt;6. Aggregate's event list&lt;/b&gt; - generic and audited, as the reference" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="386" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k7" value="&lt;b&gt;7. Entity base&lt;/b&gt; - id type and equality as the reference; waits for your ruling on id types" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="432" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k8" value="&lt;b&gt;8. Audit fields (who and when)&lt;/b&gt; - as the reference; waits for your ruling on id and time types" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="478" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k9" value="&lt;b&gt;9. Value objects&lt;/b&gt; - as the reference" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="524" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k10" value="&lt;b&gt;10. Guards&lt;/b&gt; - throw argument errors, which the mapper turns into 400" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k11" value="&lt;b&gt;11. Validation message helpers&lt;/b&gt; - the reference's 7 helpers and shared messages" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="616" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k13" value="&lt;b&gt;13. Save step that sends events&lt;/b&gt; - publishes after saving, one event at a time" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="662" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k16" value="&lt;b&gt;16. Repository extras&lt;/b&gt; - find-or-throw plus 5 more helpers" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="708" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k17" value="&lt;b&gt;17. Seed from a JSON file&lt;/b&gt; - says whether it seeded; the folder can be given" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="754" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k18" value="&lt;b&gt;18. Data context base&lt;/b&gt; - keeps the small-table cache" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="k20" value="&lt;b&gt;20. Packages&lt;/b&gt; - not a choice: .NET 10 and one central versions file" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="846" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;12. Error mapper&lt;/b&gt;&lt;br&gt;Adds 403, 409 and 502. Any other HTTP error uses its own status (today it becomes 500). A 500 no longer shows the internal message outside development. JSON names in camelCase." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="156" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;14. Table set-up&lt;/b&gt;&lt;br&gt;Drops the created-on default that works only on SQL Server, so the block works on any database." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="236" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;15. Repository upsert - bug&lt;/b&gt;&lt;br&gt;Copies the tracked values, so properties stored in private fields are saved too." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="316" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;19. FastEndpoints event publisher - bug&lt;/b&gt;&lt;br&gt;Publishes by the event's real type. Today no specific handler ever runs." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="396" width="540" height="70" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;Why these four&lt;/b&gt;&lt;br&gt;15 and 19 are bugs sprint-rituals already fixed. 12 makes the 409 error you ruled on work, and stops a 500 leaking internals. 14 is needed so a block works in any project that uses EF Core, not only on SQL Server." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="580" y="486" width="540" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
